+package billing
+
+import (
+	"context"
+	"internal/ledger"
+)
+
+// PostRefund records a settled refund as a negative entry on the customer's account.
+func PostRefund(ctx context.Context, r Refund) error {
+	return ledger.Post(ctx, ledger.Entry{Account: r.AccountID, Amount: -r.AmountCents, Ref: r.Ref})
+}
